#[test(should_revert, selector = 0x90b8ec18)]
fn missing_allowance_is_transfer_failed() uses (evm: mut Evm) {
    let usdc = evm.create2<MockUsdc>(value: Wei::zero(), args: (), salt: 0)
    let s = evm
        .create2<SplitChaiSettlement>(
            value: Wei::zero(),
            args: (usdc, treasury(), 30, evm.address()),
            salt: 0,
        )
    mint(
        usdc,
        to: evm.address(),
        amount: 10_000_000,
    ) // funds, but no approval
    let _ = settle(s, to: bob(), amount: 1_000_000)
}

#[test(should_revert, selector = 0x90b8ec18)]
fn false_returning_token_is_transfer_failed() uses (evm: mut Evm) {
    let t = evm.create2<FalseToken>(value: Wei::zero(), args: (), salt: 0)
    let s = evm
        .create2<SplitChaiSettlement>(
            value: Wei::zero(),
            args: (t, treasury(), 0, evm.address()),
            salt: 0,
        )
    let _ = settle(s, to: bob(), amount: 1_000_000)
}

/// Stricter than the Solidity original: a "token" address with no code is a
/// failed transfer, not a silent no-op.
#[test(should_revert, selector = 0x90b8ec18)]
fn codeless_token_is_transfer_failed() uses (evm: mut Evm) {
    let s = evm
        .create2<SplitChaiSettlement>(
            value: Wei::zero(),
            args: (Address::new(0xe0a), treasury(), 30, evm.address()),
            salt: 0,
        )
    let _ = settle(s, to: bob(), amount: 1_000_000)
}

/// A token that re-enters `settle` from inside `transferFrom` hits the
/// transient lock: the inner call reverts with `Reentrancy()` while the
/// outer settlement completes.
#[test]
fn reentrancy_is_blocked() uses (evm: mut Evm) {
    let t = evm.create2<ReentrantToken>(value: Wei::zero(), args: (), salt: 0)
    let s = evm
        .create2<SplitChaiSettlement>(
            value: Wei::zero(),
            args: (t, treasury(), 0, evm.address()),
            salt: 0,
        )
    evm.call(
        addr: t,
        gas: GAS,
        value: Wei::zero(),
        message: ArmMsg::Arm { target: s },
    )
    let _ = settle(s, to: bob(), amount: 1_000_000)
    let inner: u256 = evm
        .call(
            addr: t,
            gas: GAS,
            value: Wei::zero(),
            message: ArmMsg::InnerRevert {},
        )
    assert!(inner == 0xab143c06) // Reentrancy()
}

/// The lock lives in transient storage and is released after each call, so
/// two settlements in a row (same transaction) both go through.
#[test]
fn lock_is_released_between_calls() uses (evm: mut Evm) {
    let (usdc, s) = setup(owner: evm.address())
    let _ = settle(s, to: bob(), amount: 1_000_000)
    let _ = settle(s, to: carol(), amount: 1_000_000)
    assert!(balance(usdc, bob()) == 997_000)
    assert!(balance(usdc, carol()) == 997_000)
}

#[test(should_revert, selector = 0x1309a563)]
fn paused_blocks_settle() uses (evm: mut Evm) {
    let (_, s) = setup(owner: evm.address())
    evm.call(
        addr: s,
        gas: GAS,
        value: Wei::zero(),
        message: AdminMsg::SetPaused { paused: true },
    )
    let _ = settle(s, to: bob(), amount: 1_000_000)
}

#[test]
fn unpause_restores_settle() uses (evm: mut Evm) {
    let (usdc, s) = setup(owner: evm.address())
    evm.call(
        addr: s,
        gas: GAS,
        value: Wei::zero(),
        message: AdminMsg::SetPaused { paused: true },
    )
    evm.call(
        addr: s,
        gas: GAS,
        value: Wei::zero(),
        message: AdminMsg::SetPaused { paused: false },
    )
    let _ = settle(s, to: bob(), amount: 1_000_000)
    assert!(balance(usdc, bob()) == 997_000)
}

