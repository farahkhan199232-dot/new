#[test]
fn set_treasury_redirects_fees() uses (evm: mut Evm) {
    let (usdc, s) = setup(owner: evm.address())
    evm.call(
        addr: s,
        gas: GAS,
        value: Wei::zero(),
        message: AdminMsg::SetTreasury { treasury: carol() },
    )
    let _ = settle(s, to: bob(), amount: Usdc::whole(100).raw())
    assert!(balance(usdc, carol()) == 300_000)
    assert!(balance(usdc, treasury()) == 0)
}

#[test]
fn two_step_ownership() uses (evm: mut Evm) {
    let (_, s) = setup(owner: evm.address())
    let actor = evm.create2<Actor>(value: Wei::zero(), args: (), salt: 0)
    evm.call(
        addr: s,
        gas: GAS,
        value: Wei::zero(),
        message: AdminMsg::TransferOwnership { new_owner: actor },
    )
    let still: Address = evm.call(
            addr: s,
            gas: GAS,
            value: Wei::zero(),
            message: ViewMsg::Owner {},
        )
    assert!(still == evm.address())
    evm.call(
        addr: actor,
        gas: GAS,
        value: Wei::zero(),
        message: ActorMsg::Accept { target: s },
    )
    let owner: Address = evm.call(
            addr: s,
            gas: GAS,
            value: Wei::zero(),
            message: ViewMsg::Owner {},
        )
    let pending: Address = evm
        .call(
            addr: s,
            gas: GAS,
            value: Wei::zero(),
            message: ViewMsg::PendingOwner {},
        )
    assert!(owner == actor)
    assert!(pending == Address::zero())
}

#[test(should_revert, selector = 0x1853971c)]
fn only_pending_owner_accepts() uses (evm: mut Evm) {
    let (_, s) = setup(owner: evm.address())
    evm.call(
        addr: s,
        gas: GAS,
        value: Wei::zero(),
        message: AdminMsg::TransferOwnership { new_owner: carol() },
    )
    evm.call(
        addr: s,
        gas: GAS,
        value: Wei::zero(),
        message: AdminMsg::AcceptOwnership {},
    )
}

#[test]
fn quote_fee_matches_settle() uses (evm: mut Evm) {
    let (_, s) = setup(owner: evm.address())
    let quoted: u256 = evm
        .call(
            addr: s,
            gas: GAS,
            value: Wei::zero(),
            message: SettlementMsg::QuoteFee { amount: 12_345_678 },
        )
    let charged = settle(s, to: bob(), amount: 12_345_678)
    assert!(quoted == charged)
    assert!(quoted == 37_037)
}
