# YouCam API key from https://yce.makeupar.com/api-console/en/api-keys/ (India region) or yce.perfectcorp.com
YOUCAM_API_KEY=
# Optional: defaults to https://yce-api-01.makeupar.com
YOUCAM_API_BASE=
# Upstash Redis (Vercel KV). Without these the app keeps data in memory (local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
STORE_PREFIX=cptryon
# Max live YouCam tasks per day across the public demo
LIVE_TASKS_PER_DAY=40
