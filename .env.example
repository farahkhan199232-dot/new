# ---- PayPal (sandbox) ----
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client id, exposed to the browser for the PayPal JS SDK buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional. Defaults to sandbox. Never point this at live for the hackathon.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---- AI agent: Otari hosted AI gateway by Mozilla.ai (otari-wilding branch) ----
# otari.ai > your workspace > API Keys > Create Key (token starts with otk_)
OTARI_API_KEY=
# Optional (defaults shown). The gateway serves /api/v1; a trailing /v1 or /api/v1 is accepted.
# OTARI_API_BASE=https://api.otari.ai
# OTARI_MODEL=alibaba/qwen-3.5-35b-a3b
# OTARI_VISION_MODEL=alibaba/qwen-3.5-35b-a3b
# OTARI_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
# OTARI_TOOL_MODEL=alibaba/qwen-3.5-35b-a3b

# ---- Storage (Upstash Redis / Vercel KV). Leave empty for in-memory dev store ----
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional key prefix so two deployments can share one Redis without touching each other
# STORE_PREFIX=chaipot

# ---- Demo ----
# Payee used in the seeded demo pot (a PayPal sandbox personal account)
DEMO_PAYEE_EMAIL=sb-syijz53572713@personal.example.com

# ---- Optional: USDC funding on Base via the pre-existing SplitChai settlement contract ----
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_SETTLEMENT_ADDRESS=0x4ce38dbb7eb76c9f801210dfc27c43bfd009fe15
RPC_URL=
