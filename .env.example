# ---- PayPal (sandbox) ----
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client id, exposed to the browser for the PayPal JS SDK buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional. Defaults to sandbox. Never point this at live for the hackathon.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---- AI agent (Gemini, Google AI Studio key) ----
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ---- Storage (Upstash Redis / Vercel KV). Leave empty for in-memory dev store ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

